{
  "name": "boda-recuerdos",
  "version": "1.0.0",
  "description": "Álbum digital de fotos para Otto & Susy",
  "main": "server.js",
  "scripts": {
    "start": "npm run build:thumbs && node server.js",
    "dev": "node server.js",
    "build": "npm run build:css && npm run build:thumbs",
    "build:css": "npx @tailwindcss/cli -i src/input.css -o src/tailwind-output.css --minify",
    "build:thumbs": "node generate-thumbnails.js",
    "deploy": "node deploy.js"
  },
  "keywords": [
    "album",
    "fotos",
    "boda",
    "aniversario"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.18",
    "@tailwindcss/forms": "^0.5.11",
    "dotenv": "^17.3.1",
    "sharp": "^0.34.5",
    "ssh2-sftp-client": "^12.0.1",
    "tailwindcss": "^4.1.18"
  }
}